{
  "cluster": "vCloud-prod-01",
  "namespace": "hpc-compute",
  "offload_enabled": false,
  "site_accepted": false,
  "endpoint_url": "http://spinifex-controller.hpc-compute.svc.cluster.local:3000",
  "external_endpoint_url": "https://ec2.spinifex.pcloud.example.com",
  "region": "vcloud-hpc-1",
  "credentials_reference": "spinifex-aws-credentials",
  "credentials_file": "/var/run/vcloud/spinifex/aws-credentials.json",
  "ca_file": "/var/run/vcloud/trust/spinifex-ca.crt",
  "max_burst_nodes": 4,
  "queue": "spinifex-hpc-burst",
  "selector": {"vcloud.io/offload-target": "spinifex-hpc"},
  "minimum_pending_seconds": 120,
  "metrics_max_age_seconds": 60,
  "saturation_window_seconds": 300,
  "cpu_threshold": 0.85,
  "gpu_threshold": 0.85,
  "memory_threshold": 0.85,
  "cooldown_seconds": 600,
  "lease_seconds": 3600,
  "default_profile": "spinifex.gpu.h100.80gb.8x",
  "profiles": {
    "spinifex.gpu.h100.80gb.8x": {
      "gpu_model": "NVIDIA H100 SXM5",
      "gpu_count": 8,
      "vram_gb_per_gpu": 80,
      "total_vram_gb": 640,
      "instance_type": "p5.48xlarge",
      "mapping_accepted": false,
      "desired_fabric": {"nvlink_gb_per_second": 900, "ethernet_gbps": 100, "roce": true, "sriov": true}
    },
    "spinifex.gpu.a100.80gb.4x": {
      "gpu_model": "NVIDIA A100 PCIe",
      "gpu_count": 4,
      "vram_gb_per_gpu": 80,
      "total_vram_gb": 320,
      "instance_type": null,
      "mapping_accepted": false,
      "desired_fabric": {"ethernet_gbps": 100, "roce": true, "sriov": true}
    }
  },
  "launch": {"image_id": null, "subnet_id": null, "security_group_ids": []},
  "prometheus_url": "https://prometheus.platform-services.svc.cluster.local:9090",
  "prometheus_ca_file": "/var/run/vcloud/trust/prometheus-ca.crt",
  "api_server_url": "https://kubernetes.default.svc",
  "vllm_endpoint_url": "https://vcloud-vllm.hpc-compute.svc.cluster.local",
  "vllm_ca_file": "/var/run/vcloud/trust/knative-ca.crt",
  "vllm_model": "deepseek-r1-distill-qwen-32b",
  "model_repository": "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B",
  "model_revision": "711ad2ea6aa40cfca18895e8aca02ab92df1a746",
  "model_path": "/models/deepseek-r1-distill-qwen-32b",
  "agent_max_steps": 4,
  "agent_max_tokens": 1024,
  "agent_max_prompt_chars": 12000,
  "agent_batch_submission_enabled": false,
  "worker_cluster_name": "spinifex-worker-01",
  "worker_kubernetes_version": "1.36.5",
  "worker_storage_class": "vcloud-hpc-csi",
  "storage_and_fabric_accepted": false
}
