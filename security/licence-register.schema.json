{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "components"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ecosystem",
          "name",
          "version",
          "spdx",
          "class",
          "licenceSource",
          "verifiedOn",
          "recordedOn",
          "locations",
          "integrities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "spdx": {
            "type": "string",
            "minLength": 1
          },
          "licenceSource": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "adr": {
            "type": "string",
            "minLength": 1
          },
          "followUp": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "enum": [
              "oci-image",
              "helm-chart",
              "manifest",
              "npm",
              "pip",
              "github-action",
              "tool"
            ]
          },
          "class": {
            "enum": [
              "allowed",
              "build-tool",
              "weak-copyleft",
              "base-os",
              "operator-pulled",
              "disabled-module",
              "exception",
              "pending-removal",
              "blocked"
            ]
          },
          "verifiedOn": {
            "type": "string",
            "format": "date"
          },
          "recordedOn": {
            "type": "string",
            "format": "date"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "integrities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "unmodified": {
            "type": "boolean"
          },
          "separateUnit": {
            "type": "boolean"
          },
          "evidencePending": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "imageSBOM": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "class": {
                  "enum": [
                    "exception",
                    "pending-removal"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "adr",
                "expires"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "disabled-module"
                }
              }
            },
            "then": {
              "required": [
                "adr",
                "module",
                "followUp"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "enum": [
                    "weak-copyleft",
                    "operator-pulled"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "notice",
                "adr"
              ]
            }
          }
        ]
      }
    }
  }
}
