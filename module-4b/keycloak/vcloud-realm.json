{
  "realm": "vcloud",
  "displayName": "vCloud",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "vcloud-function-reader",
        "description": "May request the function.read API scope"
      }
    ]
  },
  "groups": [
    {
      "name": "vcloud",
      "subGroups": [
        {
          "name": "api-users",
          "realmRoles": [
            "vcloud-function-reader"
          ]
        },
        {
          "name": "cluster-observers"
        },
        {
          "name": "workload-readers"
        },
        {
          "name": "hpc-readers"
        }
      ]
    }
  ],
  "users": [],
  "clients": [
    {
      "clientId": "vcloud-function",
      "name": "vcloud-function",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "id.token.signed.response.alg": "RS256"
      }
    },
    {
      "clientId": "vcloud-api-cli",
      "name": "vcloud-api-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1:18000/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "function.read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "id.token.signed.response.alg": "RS256"
      }
    },
    {
      "clientId": "vcloud-kubernetes",
      "name": "vcloud-kubernetes",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8000",
        "http://localhost:18000"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "kubernetes-groups"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "id.token.signed.response.alg": "RS256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "function.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "function-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vcloud-function",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "kubernetes-groups",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "kubernetes-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "function.read",
      "roles": [
        "vcloud-function-reader"
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 40,
      "config": {}
    }
  ]
}
