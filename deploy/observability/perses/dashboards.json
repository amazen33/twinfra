[
  {
    "kind": "Project",
    "metadata": {
      "name": "twinfra"
    },
    "spec": {
      "display": {
        "name": "Twinfra"
      }
    }
  },
  {
    "kind": "Datasource",
    "metadata": {
      "name": "prometheus",
      "project": "twinfra"
    },
    "spec": {
      "display": {
        "name": "Twinfra Prometheus"
      },
      "default": true,
      "plugin": {
        "kind": "PrometheusDatasource",
        "spec": {
          "proxy": {
            "kind": "HTTPProxy",
            "spec": {
              "url": "http://twinfra-prometheus.twinfra-platform-services.svc.cluster.local:9090"
            }
          }
        }
      }
    }
  },
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "twinfra-delivery",
      "project": "twinfra"
    },
    "spec": {
      "display": {
        "name": "Twinfra delivery"
      },
      "duration": "1h",
      "refreshInterval": "30s",
      "panels": {
        "panel1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Pipeline runs"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "sum by (status) (increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"workload-apps\",pipeline=\"vcloud-ci\"}[1h]))",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "panel2": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Pipeline duration p95"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "histogram_quantile(0.95, sum by (le) (rate(tekton_pipelines_controller_pipelinerun_duration_seconds_bucket{namespace=\"workload-apps\",pipeline=\"vcloud-ci\"}[15m])))",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "panel3": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Argo CD sync and health"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "argocd_app_info{name=\"vcloud-delivery\"}",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "panel4": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Delivery alerts"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "ALERTS{alertname=~\"VCloud.*\",alertstate=\"firing\"}",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel1"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel2"
                }
              },
              {
                "x": 0,
                "y": 8,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel3"
                }
              },
              {
                "x": 12,
                "y": 8,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel4"
                }
              }
            ]
          }
        }
      ]
    }
  },
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "twinfra-health",
      "project": "twinfra"
    },
    "spec": {
      "display": {
        "name": "Twinfra environment health"
      },
      "duration": "1h",
      "refreshInterval": "30s",
      "panels": {
        "panel1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Scrape targets"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "up",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "panel2": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "PostgreSQL instances"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "cnpg_collector_up",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "panel3": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Platform alerts"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "ALERTS{alertstate=\"firing\"}",
                      "datasource": {
                        "kind": "Datasource",
                        "name": "prometheus"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel1"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel2"
                }
              },
              {
                "x": 0,
                "y": 8,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/panel3"
                }
              }
            ]
          }
        }
      ]
    }
  }
]
