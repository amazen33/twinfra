# Install as root-owned /etc/twinfra-host.env, mode 0600. Values here persist across reboot.
# The script reads this file after shell environment variables. Do not store credentials here.
# BEGIN GENERATED SSOT IDENTITY
SSOT_VERSION=2.2
CLUSTER_NAME=twinfra-dev-cairo-1
CLUSTER_DNS_NAME=twinfra-dev-cairo-1
BASE_DOMAIN=twinfra.example.com
GITOPS_REPOSITORY=amazen33/twinfra
IMAGE_REGISTRY=registry.twinfra.example.com
# END GENERATED SSOT IDENTITY
KUBERNETES_VERSION=v1.36.5
CILIUM_VERSION=1.20.2
CRICTL_VERSION=v1.36.0
HUGEPAGES_2M=128
HUGEPAGES_1G=1
MIN_NORMAL_RAM_MIB=4096
ENABLE_GPU=false
GPU_SMOKE_TEST=false
NVIDIA_DRIVER_PACKAGE=auto
ENABLE_KVM=false
INSTALL_HPC=false
BOOTSTRAP_K8S=true
RUN_SMOKE_TESTS=false
REGISTRY_MIRROR=https://registry.twinfra.example.com
MIRROR_REQUIRED=true
# REGISTRY_CA_FILE=/usr/local/share/ca-certificates/vcloud-registry.crt
POD_CIDR=10.110.0.0/16
SERVICE_CIDR=10.111.0.0/16
# Set a stable, assigned interface address if the host has multiple NICs.
# NODE_IP=192.168.50.10
# NODE_NAME=vcloud01

# Optional stable DNS authority used by kubeadm; dev overlay supplies this at init.
CONTROL_PLANE_ENDPOINT=api.dev.cairo-1.twinfra.example.com:6443
PLATFORM_PROFILE=dev-cairo-1
NODE_IP=192.168.1.3
NODE_NAME=twinfra-dev-cairo-1
IMAGE_STAGING=true
NODE_INTERFACE=eno1
