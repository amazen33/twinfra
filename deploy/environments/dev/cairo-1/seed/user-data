#cloud-config
package_update: true
package_upgrade: false
packages:
- ca-certificates
- curl
- python3
write_files:
- path: /etc/twinfra-host.env
  owner: root:root
  permissions: '0600'
  content: '# Install as root-owned /etc/vcloud-host.env, mode 0600. Values here persist
    across reboot.

    # The script reads this file after shell environment variables. Do not store credentials
    here.

    # BEGIN GENERATED SSOT IDENTITY

    SSOT_VERSION=2.2

    CLUSTER_NAME=twinfra-dev-cairo-1

    CLUSTER_DNS_NAME=twinfra-dev-cairo-1

    BASE_DOMAIN=twinfra.example.com

    GITOPS_REPOSITORY=amazen33/twinfra

    IMAGE_REGISTRY=registry.twinfra.example.com

    # END GENERATED SSOT IDENTITY

    KUBERNETES_VERSION=v1.36.5

    CILIUM_VERSION=1.20.2

    CRICTL_VERSION=v1.36.0

    HUGEPAGES_2M=128

    HUGEPAGES_1G=1

    MIN_NORMAL_RAM_MIB=4096

    ENABLE_GPU=false

    GPU_SMOKE_TEST=false

    NVIDIA_DRIVER_PACKAGE=auto

    ENABLE_KVM=false

    INSTALL_HPC=false

    BOOTSTRAP_K8S=true

    RUN_SMOKE_TESTS=false

    REGISTRY_MIRROR=https://registry.twinfra.example.com

    MIRROR_REQUIRED=true

    # REGISTRY_CA_FILE=/usr/local/share/ca-certificates/vcloud-registry.crt

    POD_CIDR=10.110.0.0/16

    SERVICE_CIDR=10.111.0.0/16

    # Set a stable, assigned interface address if the host has multiple NICs.

    # NODE_IP=192.168.50.10

    # NODE_NAME=vcloud01


    # Optional stable DNS authority used by kubeadm; dev overlay supplies this at
    init.

    CONTROL_PLANE_ENDPOINT=api.dev.cairo-1.twinfra.example.com:6443

    PLATFORM_PROFILE=dev-cairo-1

    NODE_IP=10.50.0.10

    NODE_NAME=twinfra-node

    IMAGE_STAGING=true

    '
- path: /usr/local/sbin/00-setup-ubuntu-host.sh
  owner: root:root
  permissions: '0755'
  content: "#!/usr/bin/env bash\n# Module -1: upstream Kubernetes / Cilium on a fresh\
    \ Ubuntu VM or bare-metal host.\n# Usage: bash 00-setup-ubuntu-host.sh --plan\
    \ | sudo bash ... --apply | sudo bash ... --validate\n# This script does not run\
    \ when sourced: its render/validation helpers can be tested offline.\n# Configuration:\
    \ shell environment, then root-owned /etc/vcloud-host.env if present.\n# Exit\
    \ codes: 0 = requested gates passed; 1 = failed; 2 = bad configuration;\n#   \
    \          20 = reboot required (bootstrap has deliberately been deferred).\n\
    #             42 = SSoT hostPath prohibition blocks Kubernetes bootstrap.\n# Root\
    \ is required for APT, kernel/mount/sysctl/driver configuration and kubeadm PKI.\n\
    # Ordinary validation pods run as UID 10001 without capabilities or host mounts.\n\
    # No automatic reboot, kubeadm reset, firewall disable, disk formatting, or VFIO\
    \ rebinding.\n\nload_config() {\n    local config_file=\"${VCLOUD_CONFIG_FILE:-/etc/vcloud-host.env}\"\
    \n    # An env file is executable shell configuration. Never source a writable\
    \ user file as root.\n    if [[ -f \"$config_file\" ]]; then\n        [[ $(stat\
    \ -c '%u' \"$config_file\") == 0 ]] || die \"Config must be root-owned: $config_file\"\
    \n        [[ $(stat -c '%a' \"$config_file\") =~ ^(600|644)$ ]] || die \"Config\
    \ must have mode 0600 or 0644: $config_file\"\n        # shellcheck disable=SC1090\n\
    \        source \"$config_file\"\n    fi\n    : \"${KUBERNETES_VERSION:=v1.36.5}\"\
    \ \"${CILIUM_VERSION:=1.20.2}\"\n    : \"${HELM_VERSION:=v3.22.0}\" \"${CILIUM_CLI_VERSION:=v0.20.1}\"\
    \n    : \"${KUBECONFORM_VERSION:=v0.8.0}\" \"${TKN_VERSION:=v0.46.1}\"\n    :\
    \ \"${ARGOCD_VERSION:=v3.5.3}\" \"${YQ_VERSION:=v4.54.1}\" \"${CRICTL_VERSION:=v1.36.0}\"\
    \n    : \"${NVIDIA_TOOLKIT_VERSION:=1.20.1-1}\" \"${NVIDIA_DEVICE_PLUGIN_VERSION:=0.20.1}\"\
    \n    : \"${ENABLE_GPU:=auto}\" \"${NVIDIA_DRIVER_PACKAGE:=auto}\" \"${ENABLE_KVM:=false}\"\
    \n    # ADR-0044 owner clarification: opt in only to the proprietary CUDA smoke\
    \ image.\n    : \"${GPU_SMOKE_TEST:=false}\"\n    : \"${INSTALL_HPC:=true}\" \"\
    ${BOOTSTRAP_K8S:=true}\" \"${RUN_SMOKE_TESTS:=true}\"\n    : \"${HUGEPAGES_2M:=128}\"\
    \ \"${HUGEPAGES_1G:=1}\" \"${MIN_NORMAL_RAM_MIB:=4096}\"\n    # BEGIN GENERATED\
    \ SSOT DEFAULTS\n    : \"${SSOT_VERSION:=2.2}\"\n    : \"${CLUSTER_NAME:=vCloud-prod-01}\"\
    \n    : \"${CLUSTER_DNS_NAME:=vcloud-prod-01}\"\n    : \"${BASE_DOMAIN:=vcloud.example.com}\"\
    \n    : \"${GITOPS_REPOSITORY:=amazen33/twinfra}\"\n    : \"${IMAGE_REGISTRY:=registry.vcloud.example.com}\"\
    \n    # END GENERATED SSOT DEFAULTS\n    : \"${REGISTRY_MIRROR:=https://$IMAGE_REGISTRY}\"\
    \ \"${REGISTRY_CA_FILE:=}\"\n    : \"${MIRROR_REQUIRED:=true}\" \"${REGISTRY_PROBE_IMAGE:=$IMAGE_REGISTRY/docker.io/library/busybox:1.37.0}\"\
    \n    # WO-29: explicit owner/NoCloud image staging is a dev-only bootstrap step.\n\
    \    : \"${IMAGE_STAGING:=false}\"\n    : \"${POD_CIDR:=10.42.0.0/16}\" \"${SERVICE_CIDR:=10.43.0.0/16}\"\
    \ \"${NODE_IP:=}\"\n    : \"${PLATFORM_PROFILE:=production}\" \"${CONTROL_PLANE_ENDPOINT:=}\"\
    \n    : \"${NODE_NAME:=}\" \"${PAUSE_IMAGE:=$IMAGE_REGISTRY/registry.k8s.io/pause:3.10.1}\"\
    \n    : \"${HUGEPAGE_SMOKE_IMAGE:=$IMAGE_REGISTRY/docker.io/library/python:3.12.12-slim}\"\
    \n    : \"${GPU_SMOKE_IMAGE:=$IMAGE_REGISTRY/docker.io/nvidia/cuda:12.4.1-base-ubuntu22.04}\"\
    \n    STATE_DIR=/var/lib/vcloud-host\n    CRI_SOCKET=unix:///run/containerd/containerd.sock\n\
    \    GPU_ENABLED=false\n    NEEDS_REBOOT=false\n    WORK_DIR=\n    PHASE=preflight\n\
    \    MIRROR_STATUS=not-tested\n    REBOOT_ATTEMPTED=false\n}\n\nlog() { printf\
    \ '[vCloud] %s\\n' \"$*\"; }\ndie() {\n    log \"ERROR: $*\" >&2\n    if [[ ${APPLY_ACTIVE:-false}\
    \ == true ]] && command -v jq >/dev/null; then write_result failed || true; fi\n\
    \    exit 1\n}\nbad_config() { log \"CONFIG: $*\" >&2; exit 2; }\nversion_at_least()\
    \ { [[ \"$(printf '%s\\n%s\\n' \"$2\" \"$1\" | sort -V | head -n1)\" == \"$2\"\
    \ ]]; }\n\nvalidate_config() {\n    local name value\n    validate_ssot_identity\n\
    \    for name in BOOTSTRAP_K8S INSTALL_HPC ENABLE_KVM RUN_SMOKE_TESTS GPU_SMOKE_TEST\
    \ MIRROR_REQUIRED IMAGE_STAGING; do\n        [[ ${!name} == true || ${!name} ==\
    \ false ]] || bad_config \"$name must be true or false\"\n    done\n    [[ $ENABLE_GPU\
    \ =~ ^(auto|true|false)$ ]] || bad_config 'ENABLE_GPU must be auto, true or false'\n\
    \    for name in HUGEPAGES_2M HUGEPAGES_1G MIN_NORMAL_RAM_MIB; do\n        [[\
    \ ${!name} =~ ^(0|[1-9][0-9]{0,5})$ ]] || bad_config \"$name must be a nonnegative\
    \ integer <= 999999\"\n    done\n    # Reject unsupported version combinations\
    \ before any host mutation. Overrides require a\n    # documented compatibility\
    \ review, rather than silently selecting an untested 'latest'.\n    [[ $KUBERNETES_VERSION\
    \ =~ ^v1\\.(33|34|35|36)\\.[0-9]+$ ]] || bad_config 'Kubernetes must be v1.33..v1.36\
    \ for this Cilium profile'\n    [[ $CILIUM_VERSION =~ ^1\\.20\\.[0-9]+$ ]] ||\
    \ bad_config 'This profile supports Cilium 1.20.x'\n    for name in HELM_VERSION\
    \ CILIUM_CLI_VERSION KUBECONFORM_VERSION TKN_VERSION ARGOCD_VERSION YQ_VERSION\
    \ CRICTL_VERSION; do\n        [[ ${!name} =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$ ]] ||\
    \ bad_config \"$name needs an exact vX.Y.Z release\"\n    done\n    value=${KUBERNETES_VERSION%.*}\n\
    \    [[ ${CRICTL_VERSION%.*} == \"$value\" ]] || bad_config 'crictl must use the\
    \ same Kubernetes minor version'\n    [[ $NVIDIA_TOOLKIT_VERSION =~ ^[0-9]+\\\
    .[0-9]+\\.[0-9]+-[0-9]+$ ]] || bad_config 'Toolkit requires an exact Debian version'\n\
    \    [[ $NVIDIA_DEVICE_PLUGIN_VERSION =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || bad_config\
    \ 'Device plugin requires X.Y.Z'\n    # A registry authority only: no credentials,\
    \ quotes, spaces, path-prefix rewriting or HTTP.\n    [[ $REGISTRY_MIRROR =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$\
    \ ]] || bad_config 'Mirror must be an HTTPS authority without a path or credentials'\n\
    \    [[ -z $REGISTRY_CA_FILE || $REGISTRY_CA_FILE =~ ^/[a-zA-Z0-9_./-]+$ ]] ||\
    \ bad_config 'Registry CA requires an absolute simple path'\n    [[ -z $CONTROL_PLANE_ENDPOINT\
    \ || $CONTROL_PLANE_ENDPOINT =~ ^[a-zA-Z0-9.-]+:6443$ ]] || bad_config 'CONTROL_PLANE_ENDPOINT\
    \ must be a DNS authority on 6443'\n    [[ -z $NODE_NAME || $NODE_NAME =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$\
    \ ]] || bad_config 'NODE_NAME must be a DNS label/name'\n    [[ $NVIDIA_DRIVER_PACKAGE\
    \ == auto || $NVIDIA_DRIVER_PACKAGE =~ ^nvidia-driver-[0-9]+(-server)?(-open)?$\
    \ ]] || bad_config 'Invalid NVIDIA driver package'\n    for name in PAUSE_IMAGE\
    \ GPU_SMOKE_IMAGE REGISTRY_PROBE_IMAGE HUGEPAGE_SMOKE_IMAGE; do\n        [[ ${!name}\
    \ =~ ^[a-zA-Z0-9][a-zA-Z0-9._/:@+-]+$ ]] || bad_config \"$name contains invalid\
    \ characters\"\n        [[ ${!name} == \"$IMAGE_REGISTRY/\"* ]] || bad_config\
    \ \"$name must use the SSoT registry\"\n        [[ ${!name} =~ @sha256:[a-f0-9]{64}$\
    \ || ${!name} =~ :v?[0-9]+\\.[0-9]+\\.[0-9]+([._+-][a-zA-Z0-9._+-]+)?$ ]] || bad_config\
    \ \"$name requires an exact semantic version or SHA256 digest\"\n    done\n  \
    \  # Pure stdlib check also catches CIDR overlap; host routes are checked during\
    \ preflight.\n    python3 - \"$POD_CIDR\" \"$SERVICE_CIDR\" \"$NODE_IP\" <<'PY'\n\
    import ipaddress, sys\ntry:\n    pod, svc = [ipaddress.IPv4Network(x, strict=True)\
    \ for x in sys.argv[1:3]]\n    assert not pod.overlaps(svc), 'Pod and service\
    \ CIDRs overlap'\n    assert 16 <= pod.prefixlen <= 24, 'Pod CIDR must have a\
    \ /16../24 prefix'\n    if sys.argv[3]:\n        node = ipaddress.IPv4Address(sys.argv[3])\n\
    \        assert not node.is_loopback and not node.is_unspecified, 'Node IP must\
    \ be routable'\n        assert node not in pod and node not in svc, 'Node IP overlaps\
    \ cluster CIDRs'\nexcept (ValueError, AssertionError) as e:\n    print(e, file=sys.stderr)\n\
    \    sys.exit(2)\nPY\n}\n\n# BEGIN GENERATED SSOT VALIDATION\nvalidate_ssot_identity()\
    \ {\n    case $PLATFORM_PROFILE in\n    production) [[ $SSOT_VERSION == 2.2 &&\n\
    \       $CLUSTER_NAME == vCloud-prod-01 &&\n       $CLUSTER_DNS_NAME == vcloud-prod-01\
    \ &&\n       $BASE_DOMAIN == vcloud.example.com &&\n       $GITOPS_REPOSITORY\
    \ == amazen33/twinfra &&\n       $IMAGE_REGISTRY == registry.vcloud.example.com\
    \ &&\n       $REGISTRY_MIRROR == https://registry.vcloud.example.com &&\n    \
    \   $MIRROR_REQUIRED == true && $IMAGE_STAGING == false ]] ;;\n    dev-cairo-1)\
    \ [[ $SSOT_VERSION == 2.2 && $CLUSTER_NAME == twinfra-dev-cairo-1 && $CLUSTER_DNS_NAME\
    \ == twinfra-dev-cairo-1 && $BASE_DOMAIN == twinfra.example.com && $GITOPS_REPOSITORY\
    \ == amazen33/twinfra && $IMAGE_REGISTRY == registry.twinfra.example.com && $REGISTRY_MIRROR\
    \ == https://registry.twinfra.example.com && $MIRROR_REQUIRED == true && ( $IMAGE_STAGING\
    \ == false || $IMAGE_STAGING == true ) ]] ;;\n    dev-cairo-2) [[ $SSOT_VERSION\
    \ == 2.2 && $CLUSTER_NAME == twinfra-dev-cairo-2 && $CLUSTER_DNS_NAME == twinfra-dev-cairo-2\
    \ && $BASE_DOMAIN == twinfra.example.com && $GITOPS_REPOSITORY == amazen33/twinfra\
    \ && $IMAGE_REGISTRY == registry.twinfra.example.com && $REGISTRY_MIRROR == https://registry.twinfra.example.com\
    \ && $MIRROR_REQUIRED == true && ( $IMAGE_STAGING == false || $IMAGE_STAGING ==\
    \ true ) ]] ;;\n    *) return 2 ;;\n    esac || bad_config 'Identity/registry\
    \ drift from vcloud-ssot.yaml; change the contract and regenerate first'\n}\n\
    # END GENERATED SSOT VALIDATION\n\n# BEGIN GENERATED POLICY GATE\ncheck_policy_gate()\
    \ {\n    [[ $BOOTSTRAP_K8S == true ]] || return 0\n    # Approved by the user\
    \ on 2026-10-05; no environment flag broadens the scope.\n    [[ $KUBERNETES_VERSION\
    \ == v1.36.5 && $CILIUM_VERSION == 1.20.2 && $NVIDIA_DEVICE_PLUGIN_VERSION ==\
    \ 0.20.1 ]] || {\n        log 'Node exception is pinned to the approved Kubernetes/Cilium/NVIDIA\
    \ versions; unreviewed drift rejected.' >&2\n        return 42\n    }\n}\n# END\
    \ GENERATED POLICY GATE\n\nplan() {\n    cat <<EOF\nUpstream Kubernetes $KUBERNETES_VERSION\
    \ via kubeadm; Cilium $CILIUM_VERSION replaces kube-proxy.\nSSoT $SSOT_VERSION:\
    \ $CLUSTER_NAME, $BASE_DOMAIN, GitOps $GITOPS_REPOSITORY.\nUbuntu 24.04 LTS, kernel\
    \ >= 6.8, cgroup v2, bpffs, overlayfs, swap disabled.\nHugeTLB: $HUGEPAGES_2M\
    \ x 2 MiB + $HUGEPAGES_1G x 1 GiB; ordinary RAM floor $MIN_NORMAL_RAM_MIB MiB.\n\
    System containerd CRI: $CRI_SOCKET, systemd cgroups, TLS mirror $REGISTRY_MIRROR.\n\
    GPU=$ENABLE_GPU, KVM=$ENABLE_KVM, HPC=$INSTALL_HPC, bootstrap=$BOOTSTRAP_K8S,\
    \ smoke=$RUN_SMOKE_TESTS, gpu-smoke=$GPU_SMOKE_TEST.\nPods=$POD_CIDR services=$SERVICE_CIDR.\
    \ A fresh single-node control plane also schedules workloads.\nCilium native routing\
    \ requires underlay routes to every remote node PodCIDR; no overlay is installed.\n\
    Node exception approved: only the pinned kubeadm/Cilium/NVIDIA scope passes manifest\
    \ checks.\nApply may exit 20. Reboot Ubuntu and rerun with the same /etc/vcloud-host.env.\n\
    This plan makes no changes. Consult docs/module-minus-1.md for sizing, passthrough\
    \ and acceptance gates.\nEOF\n}\n\n# Replace only changed content, retain one\
    \ original backup, and preserve stable mtimes.\n# Returns success in both cases;\
    \ callers inspect FILE_CHANGED to decide on service restarts.\nwrite_file() {\n\
    \    local destination=$1 mode=${2:-0644} candidate\n    candidate=$(mktemp \"\
    $WORK_DIR/file.XXXXXX\")\n    cat > \"$candidate\"\n    FILE_CHANGED=false\n \
    \   if [[ ! -f $destination ]] || ! cmp -s \"$candidate\" \"$destination\"; then\n\
    \        mkdir -p \"$(dirname \"$destination\")\"\n        if [[ -f $destination\
    \ && ! -e ${destination}.vcloud-original ]]; then\n            cp -a -- \"$destination\"\
    \ \"${destination}.vcloud-original\"\n        fi\n        install -m \"$mode\"\
    \ \"$candidate\" \"$destination\"\n        FILE_CHANGED=true\n    fi\n    chmod\
    \ \"$mode\" \"$destination\"\n    rm -f -- \"$candidate\"\n}\n\nfetch() { curl\
    \ --fail --silent --show-error --location --proto '=https' --tlsv1.2 --retry 4\
    \ --connect-timeout 15 --max-time 600 \"$1\" -o \"$2\"; }\n\n# Exact release assets\
    \ are verified against GitHub's published SHA-256 digest over TLS.\n# Missing\
    \ digests are a failure, never an excuse to execute unverified downloads.\ngh_asset()\
    \ {\n    local repo=$1 tag=$2 asset=$3 output=$4 digest url metadata\n    metadata=\"\
    $WORK_DIR/release.json\"\n    fetch \"https://api.github.com/repos/$repo/releases/tags/$tag\"\
    \ \"$metadata\"\n    url=$(jq -er --arg name \"$asset\" '.assets[] | select(.name\
    \ == $name) | .browser_download_url' \"$metadata\")\n    digest=$(jq -er --arg\
    \ name \"$asset\" '.assets[] | select(.name == $name) | .digest' \"$metadata\"\
    )\n    [[ $digest =~ ^sha256:[a-f0-9]{64}$ ]] || die \"No SHA-256 published for\
    \ $repo $tag $asset\"\n    fetch \"$url\" \"$output\"\n    printf '%s  %s\\n'\
    \ \"${digest#sha256:}\" \"$output\" | sha256sum -c -\n}\n\ninstall_cli() {\n \
    \   local binary=$1 version=$2 repo=$3 asset=$4 member=${5:-} stamp archive unpack\n\
    \    stamp=\"$STATE_DIR/cli-$binary\"\n    # A stamp includes the installed hash,\
    \ so a replaced binary is detected on rerun.\n    if [[ -x /usr/local/bin/$binary\
    \ && -f $stamp ]] &&\n        [[ $(head -n1 \"$stamp\") == \"$version/$ARCH\"\
    \ ]] &&\n        [[ $(tail -n1 \"$stamp\") == \"$(sha256sum \"/usr/local/bin/$binary\"\
    \ | cut -d' ' -f1)\" ]]; then\n        return\n    fi\n    archive=\"$WORK_DIR/$asset\"\
    \n    gh_asset \"$repo\" \"$version\" \"$asset\" \"$archive\"\n    if [[ -n $member\
    \ ]]; then\n        unpack=\"$WORK_DIR/unpack-$binary\"\n        mkdir -p \"$unpack\"\
    \n        tar -xzf \"$archive\" -C \"$unpack\" \"$member\"\n        install -m\
    \ 0755 \"$unpack/$member\" \"/usr/local/bin/$binary\"\n    else\n        install\
    \ -m 0755 \"$archive\" \"/usr/local/bin/$binary\"\n    fi\n    printf '%s/%s\\\
    n%s\\n' \"$version\" \"$ARCH\" \"$(sha256sum \"/usr/local/bin/$binary\" | cut\
    \ -d' ' -f1)\" > \"$stamp\"\n}\n\ninstall_missing() {\n    local package\n   \
    \ local -a missing=()\n    for package in \"$@\"; do\n        if [[ $(dpkg-query\
    \ -W -f='${Status}' \"$package\" 2>/dev/null || true) != 'install ok installed'\
    \ ]]; then\n            missing+=(\"$package\")\n        fi\n    done\n    if\
    \ ((${#missing[@]})); then apt-get install -y --no-install-recommends \"${missing[@]}\"\
    ; fi\n}\n\npreflight() {\n    [[ $EUID == 0 ]] || die 'Run apply/validate as root'\n\
    \    [[ $(uname -s) == Linux && -r /etc/os-release ]] || die 'A real Ubuntu host\
    \ is required'\n    # shellcheck disable=SC1091\n    source /etc/os-release\n\
    \    [[ $ID == ubuntu && $VERSION_ID == 24.04 ]] || die 'SSoT v2.2 requires Ubuntu\
    \ 24.04 LTS'\n    [[ -d /run/systemd/system ]] || die 'systemd must be PID 1;\
    \ containers and WSL are not supported targets'\n    case $(dpkg --print-architecture)\
    \ in amd64) ARCH=amd64; TKN_ARCH=x86_64;; arm64) ARCH=arm64; TKN_ARCH=aarch64;;\
    \ *) die 'Only amd64 and arm64 are supported';; esac\n    NODE_NAME=${NODE_NAME:-$(hostname\
    \ -s | tr '[:upper:]' '[:lower:]')}\n    NODE_IP=${NODE_IP:-$(ip -4 route get\
    \ 1.1.1.1 | awk '{for (i=1;i<=NF;i++) if ($i==\"src\") { print $(i+1); exit }}')}\n\
    \    [[ -n $NODE_IP ]] || die 'No default IPv4 route; set NODE_IP explicitly'\n\
    \    validate_config\n    # Do not adopt an existing cluster or overwrite an unrelated\
    \ runtime configuration.\n    if [[ -e /etc/kubernetes/admin.conf && ! -e $STATE_DIR/cluster-owned\
    \ ]]; then die 'Existing Kubernetes cluster is unmanaged'; fi\n    if [[ -e /etc/containerd/config.toml\
    \ && ! -e $STATE_DIR/containerd-owned ]] &&\n        systemctl is-active --quiet\
    \ containerd; then die 'An existing active containerd is unmanaged; use a fresh\
    \ host'; fi\n    if [[ -f $STATE_DIR/cluster-version && $(cat \"$STATE_DIR/cluster-version\"\
    ) != \"$KUBERNETES_VERSION\" ]]; then\n        die 'Cluster version differs. Use\
    \ the kubeadm upgrade procedure rather than this bootstrap'\n    fi\n    if systemctl\
    \ is-active --quiet k3s || systemctl is-active --quiet rke2-server; then die 'A\
    \ different Kubernetes distribution is active'; fi\n    # Reject overlap with\
    \ existing NIC routes before creating the cluster. Ignore cluster routes\n   \
    \ # only after this bootstrap has initialized its own node.\n    if [[ ! -e $STATE_DIR/cluster-owned\
    \ ]]; then\n        ip -j -4 route show | python3 -c '\nimport ipaddress, json,\
    \ sys\nnets = [ipaddress.ip_network(x) for x in sys.argv[1:]]\nfor route in json.load(sys.stdin):\n\
    \    dst = route.get(\"dst\", \"default\")\n    if dst != \"default\" and any(ipaddress.ip_network(dst).overlaps(n)\
    \ for n in nets):\n        sys.exit(\"Existing host route overlaps the pod/service\
    \ network: \" + dst)\n' \"$POD_CIDR\" \"$SERVICE_CIDR\"\n    fi\n    local mem_mib\
    \ reservation_mib\n    (( $(nproc) >= 2 )) || die 'At least two CPU cores are\
    \ required'\n    (( $(df -Pm /var/lib | awk 'NR==2 {print $4}') >= 20480 )) ||\
    \ die 'At least 20 GiB of free /var/lib storage is required'\n    mem_mib=$(awk\
    \ '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)\n    reservation_mib=$((HUGEPAGES_2M\
    \ * 2 + HUGEPAGES_1G * 1024))\n    ((mem_mib - reservation_mib >= MIN_NORMAL_RAM_MIB))\
    \ || die \"HugePages leave less than $MIN_NORMAL_RAM_MIB MiB ordinary RAM\"\n\
    \    if ((HUGEPAGES_1G > 0)) && [[ $ARCH == amd64 ]]; then\n        grep -qw pdpe1gb\
    \ /proc/cpuinfo || die 'CPU/VM hides 1 GiB pages; expose host CPU features or\
    \ set HUGEPAGES_1G=0'\n    fi\n    if [[ $ENABLE_GPU != false ]]; then\n     \
    \   local device vendor class\n        for device in /sys/bus/pci/devices/*; do\n\
    \            [[ -r $device/vendor && -r $device/class ]] || continue\n       \
    \     vendor=$(cat \"$device/vendor\"); class=$(cat \"$device/class\")\n     \
    \       if [[ $vendor == 0x10de && ( $class == 0x03* || $class == 0x12* ) ]];\
    \ then GPU_ENABLED=true; break; fi\n        done\n        [[ $ENABLE_GPU != true\
    \ || $GPU_ENABLED == true ]] || die 'No passed-through NVIDIA GPU detected'\n\
    \    fi\n    [[ -z $REGISTRY_CA_FILE || -r $REGISTRY_CA_FILE ]] || die 'Registry\
    \ CA file is missing'\n    log \"Ubuntu $VERSION_ID/$ARCH node=$NODE_NAME IP=$NODE_IP\
    \ GPU=$GPU_ENABLED\"\n}\n\nmark_reboot() {\n    NEEDS_REBOOT=true\n    printf\
    \ '%s\\n' \"$*\" >> \"$STATE_DIR/reboot-required\"\n    cat /proc/sys/kernel/random/boot_id\
