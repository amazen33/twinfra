- path: /etc/systemd/system/twinfra-node-zone.service
  permissions: '0644'
  content: '[Unit]

    After=kubelet.service

    StartLimitIntervalSec=0

    [Service]

    Type=oneshot

    ExecStart=/usr/local/sbin/twinfra-node-profile.sh

    Restart=on-failure

    RestartSec=30

    [Install]

    WantedBy=multi-user.target

    '
- path: /usr/local/sbin/twinfra-node-profile.sh
  permissions: '0755'
  content: '#!/usr/bin/env bash

    set -Eeuo pipefail

    export KUBECONFIG=/etc/kubernetes/admin.conf

    kubectl label node twinfra-node topology.kubernetes.io/zone=cairo-1a twinfra.io/environment=dev
    twinfra.io/region=cairo-1 --overwrite

    '
runcmd:
- - systemctl
  - daemon-reload
- - systemctl
  - enable
  - vcloud-host-bootstrap.service
- - bash
  - -c
  - VCLOUD_CONFIG_FILE=/etc/twinfra-host.env /usr/local/sbin/00-setup-ubuntu-host.sh
    --apply; rc=$?; if [ "$rc" -eq 20 ]; then exit 0; fi; exit "$rc"
- - systemctl
  - enable
  - --now
  - twinfra-node-zone.service
power_state:
  mode: reboot
  delay: now
  timeout: 120
  message: Activating vCloud host kernel, cgroups and HugePages
  condition:
  - test
  - -f
  - /var/lib/vcloud-host/reboot-required
final_message: vCloud provisioning invoked. Check /var/lib/vcloud-host/result.json
  and journalctl -u vcloud-host-bootstrap.service; cloud-init success alone is not
  cluster readiness.
users:
- name: twinfra-operator
  sudo:
  - ALL=(ALL) NOPASSWD:ALL
  shell: /bin/bash
  lock_passwd: true
  ssh_authorized_keys:
  - '@@SSH_PUBLIC_KEY@@'
ssh_pwauth: false
hostname: twinfra-dev-cairo-1
manage_etc_hosts: true
